  "homepage": "https://github.com/alexiosg111/vss#readme",
  "release": {
    "version": "0.8.0",
    "date": "2024-01-07",
    "features": [
      "Above-the-fold diagonal split with HeroSplit",
      "Interactive split-screen layout",
      "Inverse hover effects between sides",
      "Diagonal divider with animations",
      "Center brand logo with glass morphism",
      "Contact info bar integration",
      "Floating animation elements",
      "Split-screen CTAs for each service"
    ],
    "improvements": [
      "Modern split-screen design",
      "Better visual hierarchy",
      "Interactive hover states",
      "Enhanced animations",
      "Mobile responsive split layout",
      "Professional brand presentation"
