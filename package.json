{
  "name": "vss-website-redesign",
  "version": "0.7.0",
  "private": true,
  "description": "VSS Website Redesign v0.7.0 - Exact Above-The-Fold Homepage Split-Screen (Diagonal) + Inverse Hover",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "setup": "./setup.sh",
    "preview": "./preview.sh",
    "docker:dev": "docker-compose up vss-website",
    "docker:prod": "docker-compose --profile production up --build",
    "docker:down": "docker-compose down",
    "test": "npm run build",
    "deploy:vercel": "vercel --prod",
    "deploy:static": "next export",
    "analyze": "cross-env ANALYZE=true npm run build"
  },
  "dependencies": {
    "framer-motion": "^12.24.0",
    "lucide-react": "^0.263.1",
    "next": "^15.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.16",
    "cross-env": "^7.0.3",
    "eslint": "^8.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "nextjs",
    "typescript",
    "tailwindcss",
    "framer-motion",
    "vss",
    "container-scroll-animation",
    "industrial",
    "high-tech",
    "setup-system",
    "one-click",
    "docker",
    "live-monitor",
    "setup-monitor",
    "interactive-setup",
    "enhanced-monitoring",
    "stats-dashboard",
    "above-the-fold",
    "diagonal-split",
    "inverse-hover"
  ],
  "author": "VSS Development Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexiosg111/vss.git"
  },
  "homepage": "https://github.com/alexiosg111/vss#readme",
  "release": {
    "version": "0.7.0",
    "date": "2026-01-07",
    "features": [
      "Exact VSS Homepage Above-The-Fold recreation (Split-Screen)",
      "Diagonal split (\\) with smooth clip-path transitions",
      "Inverse hover: Hover Mobilfunk -> effect on Aufzüge (and vice versa)",
      "Authentic 2-color palette extracted from original VSS homepage",
      "Integrated original homepage images (Mobilfunk + Aufzüge)",
      "New routes: /aufzug and /mobilfunk"
    ],
    "improvements": [
      "Improved authenticity vs. original website",
      "Clearer visual hierarchy above-the-fold",
      "Better text readability via overlays",
      "Responsive fallback (stacked panels on mobile)"
    ]
  }
}
