    "type": "git",
    "url": "https://github.com/alexiosg111/vss.git"
  },
  "homepage": "https://github.com/alexiosg111/vss#readme",
  "release": {
    "version": "0.3.0",
    "date": "2024-01-06",
    "features": [
      "Interactive Setup Monitor with Live Status",
      "Real-time Progress Tracking",
      "Automatic Browser Opening",
      "Cross-platform Setup Scripts",
      "Server Status Monitoring",
      "Visual Setup Process",
      "Enhanced User Experience"
    ],
    "improvements": [
      "No more disappearing setup windows",
      "Clear visual feedback during setup",
      "Automatic server status detection",
      "Live monitoring dashboard",
      "Cross-platform compatibility"
    ]
  }
