{
  "name": "vss-website-redesign",
  "version": "0.8.0",
  "private": true,
  "description": "VSS Website Redesign with Enhanced Features - v0.8.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "setup": "./setup.sh",
    "preview": "./preview.sh",
    "docker:dev": "docker-compose up vss-website",
    "docker:prod": "docker-compose --profile production up --build",
