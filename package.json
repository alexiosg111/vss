  "release": {
    "date": "2026-01-16",
    "type": "major",
    "features": [
      "SplitShowcase Diagonal Split-Screen Layout",
      "Three.js WebGL Shader mit interaktiven Effekten",
      "Inverse Maus-Interaktionslogik",
      "Hitbox-Präzision auf diagonaler Trennlinie",
      "Tablet-Optimierungen (768-1024px)",
      "Windows setup.bat Fix für EPERM-Fehler",
      "Funktionierende Navigation zu Services"
    ],
    "improvements": [
      "Optimierte 3D Scroll Animation für Tablets",
      "Smoother Scale Transitions auf iPad & ähnlichen Geräten",
      "Reduzierter Rotationswinkel für bessere Tablet-Erfahrung",
      "Enhanced Responsive Breakpoints",
      "Bessere iPad & Android tablet detection",
      "Refined animation parameters für mid-size screens",
      "Consistent 60fps performance across all devices",
      "Precise transition point at the diagonal split",
      "Improved Shader Performance and Visuals",
      "Direct links to Service sections from Hero",
      "Better UX mit clear interactive states"
    ],
    "breakingChanges": [
      "None - Full backwards compatibility"
    ]
  }
