  "release": {
    "version": "0.20.0",
    "date": "2025-01-11",
    "features": [
      "Added global Header component with dark mode toggle",
      "Responsive navigation (Services, Mobilfunk, Fahrstuhl, Kontakt)",
      "Clean, modern header design",
      "System preference detection for dark/light mode",
      "Toggle button with Sun/Moon icons",
      "Logo with VSS branding",
      "Smooth background color transitions"
    ],
    "improvements": [
      "Global header instead of section-specific headers",
      "Centralized navigation state",
      "Dark mode available for all sections",
      "Improved user experience with theme control",
      "Consistent branding across all pages"
    ],
    "breakingChanges": [
      "Header moved to global component",
      "Section-specific headers removed"
      "Dark mode state management changed"
    ]
  }
